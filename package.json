{
  "name": "cmd-space",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "A local browser workspace for real Windows Command Prompt sessions.",
  "scripts": {
    "dev": "node server/index.js --dev",
    "build": "tsc --noEmit && vite build",
    "start": "node server/index.js",
    "test": "node --test --test-concurrency=1 tests/*.test.js"
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "dependencies": {
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/addon-search": "^0.16.0",
    "@xterm/addon-serialize": "^0.14.0",
    "@xterm/headless": "^6.0.0",
    "@xterm/xterm": "^6.0.0",
    "lucide-react": "^1.47.0",
    "node-pty": "1.1.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "ws": "^8.21.3"
  },
  "devDependencies": {
    "@types/node": "^26.6.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.0"
  }
}
